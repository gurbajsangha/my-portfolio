{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gurbaj-singh-portfolio",
  "compatibility_date": "2025-01-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
